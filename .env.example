# === Database (PostgreSQL) ===
# Every table, including the agent's conversation checkpoints. docker compose
# builds DATABASE_URL from the POSTGRES_* values below and ignores this one;
# set DATABASE_URL yourself only when running the backend outside compose.
# POSTGRES_PASSWORD=change-me
# DATABASE_URL=postgresql://scholar:scholar@localhost:5432/scholar
# Connections per backend process (a small checkpoint pool comes on top).
# DATABASE_POOL_MIN=1
# DATABASE_POOL_MAX=10

# === LLM (Qwen / DashScope MaaS Responses API) ===
# Use the MaaS compatible-mode base URL from Model Studio, e.g.
# https://llm-xxxx.cn-beijing.maas.aliyuncs.com/api/v2/apps/protocols/compatible-mode/v1
LLM_BASEURL="https://your-maas-endpoint/api/v2/apps/protocols/compatible-mode/v1"
LLM_APIKEY="your-api-key"
# THINKING_MODELNAME accepts a comma-separated list of selectable models. The
# first entry is the default; the frontend offers the full list as a dropdown.
# All listed models are called via POST /responses with enable_thinking=true.
# e.g. THINKING_MODELNAME=qwen3.8-max,qwen3.7-plus,qwen3.7-max
THINKING_MODELNAME=your-model-name
EMBED_MODELNAME=your-embed-model
RERANK_MODELNAME=your-rerank-model

# === MinerU PDF Parsing ===
MINERU_TOKEN="your-mineru-token"
# Stop waiting on a remote queue after 5 minutes; retain its batch for a later
# turn rather than upload/charge again. 0 disables this queue-specific limit.
# MINERU_QUEUE_TIMEOUT_SECONDS=300
# MINERU_PARSE_TIMEOUT_SECONDS=1800

# === Tavily web search (PublicationRank SCI/CCF fallback) ===
TAVILY_KEY="your-tavily-api-key"

# === PublicationRank / EasyScholar ===
EASYSCHOLAR_SECRET_KEY="your-easyscholar-secret-key"
# EASYSCHOLAR_API_URL="https://www.easyscholar.cc/open/getPublicationRank"

# === Research Sphere (optional) ===
# SPHERE_RADIUS=1
# SPHERE_CANDIDATE_CAP=200
# Max candidates entering the LLM relevance gate
# SPHERE_GATE_CAP=120
# Final core-set size (papers used for all synthesis/reporting)
# SPHERE_CORE_CAP=40
# SPHERE_PDF_PARSE_CAP=0
# Keyword-search-only hits need >= this many citations or a ranked venue
# SPHERE_T3_MIN_CITATIONS=5
# EasyScholar venue-rank lookup during Sphere scoring (cache-backed)
# SPHERE_VENUE_RANK_ENABLED=true
# A post-center-year paper needs >= this many citations (or a ranked venue)
# to claim a "frontier" seat, not just be the newest
# SPHERE_FRONTIER_MIN_CITATIONS=10

# === Dify knowledge base (optional) ===
# Base URL of your self-hosted Dify knowledge API proxy. Empty disables all
# library features (the /api/library/* endpoints, corpus Q&A, and the Sphere
# "Related work in your library" section). The proxy holds the Dify API key
# server-side, so no key is set here.
# DIFY_API_BASE=http://8.217.68.153:3002
# Pin a dataset id; leave empty to use the proxy's own default dataset.
# DIFY_DEFAULT_DATASET_ID=24c4452a-5a66-4605-a6a1-9e0a7954cf87
# Default retrieval method: full_text_search (fast) | semantic_search | hybrid_search (slow, 8B reranker).
# DIFY_SEARCH_METHOD=full_text_search
# DIFY_TIMEOUT_SECONDS=90
# How many library candidates Research Sphere pulls per run (0 disables the Sphere channel).
# DIFY_SPHERE_TOP_K=10

# === R2 / S3-compatible object storage (optional, figure hosting for exports) ===
# When fully configured, figures embedded in reports are uploaded here and
# referenced by public URL in exports (Zotero note + Markdown), so images render
# outside the app. Leave empty to keep the original behaviour (the Zotero note
# inlines figures as base64; the Markdown keeps in-app links).
# Note: R2_BUCKET must be the bucket bound to R2_PUBLIC_BASE_URL's domain.
# R2_ACCOUNT_ID=your-account-id
# R2_ACCESS_KEY_ID=your-access-key-id
# R2_SECRET_ACCESS_KEY=your-secret-access-key
# R2_BUCKET=your-bucket
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# R2_PUBLIC_BASE_URL=https://your-public-domain

# === Paper agent (Deep Agents Smart Q&A, optional) ===
# Model for the conversational reading agent. Empty falls back to the first
# entry of THINKING_MODELNAME. The configured MaaS gateway serves /responses
# only (POST /chat/completions answers "not support"), which the agent model
# adapter accounts for; local function tools work over /responses.
# AGENT_MODELNAME=qwen3.8-max
# Per-request timeout for the agent's model calls. Agent turns carry long tool
# transcripts, so this sits well above a plain chat call.
# AGENT_REQUEST_TIMEOUT_SECONDS=300
# Transport-level retries inside the model client (connection resets, 5xx).
# AGENT_MAX_RETRIES=3
# HMAC secret signing anonymous agent credentials, event-stream tickets and the
# OAuth login state. Empty generates one and
# persists it under the data dir, so local dev needs no configuration. Set it
# explicitly in production, and identically across instances: a restart with a
# different secret invalidates every credential already issued to a browser.
# AGENT_IDENTITY_SECRET=
# Per-run ceilings, enforced by the executor rather than asked of the model.
# Reaching one ends the turn with whatever was found, reported as such.
# AGENT_MAX_TOOL_CALLS=40
# Downloads and parses are the two that cost real money — a PDF fetch and a
# MinerU job of several minutes — so they are the two worth tuning per install.
# AGENT_MAX_DOWNLOADS=5
# AGENT_MAX_PARSES=3
# AGENT_MAX_TOKENS=400000
# Generous, because one turn may now find, download and parse a paper.
# AGENT_MAX_WALL_SECONDS=1800
# Streamed answer text is written as one event per window rather than one per
# model chunk (each event is a committed row).
# AGENT_DELTA_FLUSH_MS=150
# AGENT_DELTA_FLUSH_CHARS=1500
# Conversation size (approx. tokens) at which older turns are summarised.
# Gateway models publish no profile, so this is an absolute number.
# AGENT_CONTEXT_TRIGGER_TOKENS=80000
# How many recent messages survive a compaction untouched.
# AGENT_CONTEXT_KEEP_MESSAGES=12
# Old tool results beyond the most recent N are stubbed (evidence ids kept).
# AGENT_TOOL_RESULT_KEEP=6
# AGENT_TOOL_RESULT_MAX_CHARS=1500
# Ceiling on long-term memories injected into the prompt per turn (newest first).
# AGENT_MEMORY_MAX_ITEMS=30

# === Accounts (P7.5) ===
# multi_user: OAuth logins, optionally beside anonymous trial use.
# single_user: a private instance for one person — no login, no quotas.
# AUTH_MODE=multi_user
# Let visitors use the app before logging in (multi_user only). Off means
# creating sessions, uploading and starting reports all need a login.
# AUTH_ALLOW_ANONYMOUS=true
# The origin the browser sees (the frontend). Each provider's callback URL is
# <PUBLIC_BASE_URL>/api/auth/callback/<github|google|linuxdo> and must be
# registered with that provider exactly.
# PUBLIC_BASE_URL=http://localhost:3001
# Login cookies are Secure (HTTPS only). Browsers accept Secure cookies on
# http://localhost; set false only for plain-http access from another host.
# AUTH_COOKIE_SECURE=true
# Login sessions last this many days since last use.
# AUTH_SESSION_DAYS=30
# A provider appears on the login menu once both values are set.
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# LINUX DO Connect (https://connect.linux.do)
# OAUTH_LINUXDO_CLIENT_ID=
# OAUTH_LINUXDO_CLIENT_SECRET=
# An administrator who logs in with a username and password (multi_user only),
# offered on the login menu once both are set — for local testing and personal
# deployments without an OAuth app. The account is created on startup, has no
# daily quota, and also opens /api/admin/* when ADMIN_API_TOKEN is set.
# Changing either value (or removing them) logs out every admin session on the
# next start. Use a long random password on anything reachable from outside.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
# Daily agent quotas per principal (UTC day). 0 = unlimited.
# QUOTA_ANON_DAILY_RUNS=20
# QUOTA_ANON_DAILY_TOKENS=1000000
# QUOTA_USER_DAILY_RUNS=200
# QUOTA_USER_DAILY_TOKENS=10000000

# === Docker registry mirror (optional, for China mainland) ===
# REGISTRY_MIRROR=docker.1ms.run
