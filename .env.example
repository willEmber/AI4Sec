# === LLM (Qwen Responses API) ===
LLM_BASEURL="https://dashscope.aliyuncs.com/api/v2/apps/protocols/compatible-mode/v1"
LLM_APIKEY="your-api-key"
# THINKING_MODELNAME accepts a comma-separated list of selectable models. The
# first entry is the default; the frontend offers the full list as a dropdown.
# e.g. THINKING_MODELNAME=qwen3.6-plus,qwen3.7-max
THINKING_MODELNAME=your-model-name
EMBED_MODELNAME=your-embed-model
RERANK_MODELNAME=your-rerank-model

# === MinerU PDF Parsing ===
MINERU_TOKEN="your-mineru-token"

# === Tavily web search (PublicationRank SCI/CCF fallback) ===
TAVILY_KEY="your-tavily-api-key"

# === PublicationRank / EasyScholar ===
EASYSCHOLAR_SECRET_KEY="your-easyscholar-secret-key"
# EASYSCHOLAR_API_URL="https://www.easyscholar.cc/open/getPublicationRank"

# === Research Sphere (optional) ===
# SPHERE_RADIUS=1
# SPHERE_CANDIDATE_CAP=200
# Max candidates entering the LLM relevance gate
# SPHERE_GATE_CAP=120
# Final core-set size (papers used for all synthesis/reporting)
# SPHERE_CORE_CAP=40
# SPHERE_PDF_PARSE_CAP=0
# Keyword-search-only hits need >= this many citations or a ranked venue
# SPHERE_T3_MIN_CITATIONS=5
# EasyScholar venue-rank lookup during Sphere scoring (cache-backed)
# SPHERE_VENUE_RANK_ENABLED=true
# A post-center-year paper needs >= this many citations (or a ranked venue)
# to claim a "frontier" seat, not just be the newest
# SPHERE_FRONTIER_MIN_CITATIONS=10

# === Dify knowledge base (optional) ===
# Base URL of your self-hosted Dify knowledge API proxy. Empty disables all
# library features (the /api/library/* endpoints, corpus Q&A, and the Sphere
# "Related work in your library" section). The proxy holds the Dify API key
# server-side, so no key is set here.
# DIFY_API_BASE=http://8.217.68.153:3002
# Pin a dataset id; leave empty to use the proxy's own default dataset.
# DIFY_DEFAULT_DATASET_ID=24c4452a-5a66-4605-a6a1-9e0a7954cf87
# Default retrieval method: full_text_search (fast) | semantic_search | hybrid_search (slow, 8B reranker).
# DIFY_SEARCH_METHOD=full_text_search
# DIFY_TIMEOUT_SECONDS=90
# How many library candidates Research Sphere pulls per run (0 disables the Sphere channel).
# DIFY_SPHERE_TOP_K=10

# === R2 / S3-compatible object storage (optional, figure hosting for exports) ===
# When fully configured, figures embedded in reports are uploaded here and
# referenced by public URL in exports (Zotero note + Markdown), so images render
# outside the app. Leave empty to keep the original behaviour (the Zotero note
# inlines figures as base64; the Markdown keeps in-app links).
# Note: R2_BUCKET must be the bucket bound to R2_PUBLIC_BASE_URL's domain.
# R2_ACCOUNT_ID=your-account-id
# R2_ACCESS_KEY_ID=your-access-key-id
# R2_SECRET_ACCESS_KEY=your-secret-access-key
# R2_BUCKET=your-bucket
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# R2_PUBLIC_BASE_URL=https://your-public-domain

# === Docker registry mirror (optional, for China mainland) ===
# REGISTRY_MIRROR=docker.1ms.run
